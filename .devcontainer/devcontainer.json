{
  "name": "Shopping Mall Agentic RAG Container",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
        "eamodio.gitlens"
      ]
    }
  },
  "forwardPorts": [8000, 11434, 7997, 6379, 8200],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Web & REST API",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama Local LLM API",
      "onAutoForward": "ignore"
    },
    "7997": {
      "label": "Infinity Embedding API",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode"
}
