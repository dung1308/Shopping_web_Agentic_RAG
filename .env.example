# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ──────────────────────────────────────────────────────────────
API_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=malluser
POSTGRES_PASSWORD=mallpass
POSTGRES_DB=mallrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async DSN (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://malluser:mallpass@localhost:5432/mallrag

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=mall_products
# CHROMA_HOST=localhost
# CHROMA_PORT=8200

# ── Local LLM (Ollama / vLLM — OpenAI-compatible endpoint) ───────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama         # placeholder; Ollama doesn't require a real key
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Embedding Model (Infinity + bge-m3) ───────────────────────────────────
EMBED_BASE_URL=http://localhost:7997
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_DEVICE=cpu           # change to "cuda" if GPU available

# ── Scraping ──────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
SCRAPE_CONCURRENCY=4
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_CRON="0 */6 * * *"

# ── Docling extraction ────────────────────────────────────────────────────
# Device: "cpu" (safe for limited VRAM), "cuda" (5-6x faster if GPU available)
DOCLING_DEVICE=cpu
DOCLING_ENABLE_OCR=true
# OCR engine: "easyocr" (pip install, no system deps) | "tesseract" (needs system install)
DOCLING_OCR_ENGINE=easyocr

# ── Chunking ──────────────────────────────────────────────────────────────
INGEST_CHUNK_SIZE=512          # Max tokens per RAG chunk
INGEST_CHUNK_OVERLAP=64        # Overlap tokens between chunks
INGEST_MAX_FILE_MB=50          # Max local file size in MB

# ── LLM Reader ────────────────────────────────────────────────────────────
# Provider for document reading/enrichment after extraction.
# Options: "openai" | "anthropic" | "gemini" | "local" | "none"
# "local"  = uses Ollama (no API key, CPU-safe, default)
# "none"   = skip LLM reading (pure Docling extraction + embedding only)
LLM_READER_PROVIDER=local

# ── LLM API Keys (optional — only needed for cloud providers) ─────────────
# OpenAI — GPT-4o, best multimodal quality, vision for images
OPENAI_API_KEY=

# Anthropic — Claude, Files API upload-once, prompt caching (60-90% cost savings)
ANTHROPIC_API_KEY=

# Google Gemini — native PDF inline, multimodal file search, fast
GEMINI_API_KEY=

# ── MCP ───────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_SSE_PORT=8001
